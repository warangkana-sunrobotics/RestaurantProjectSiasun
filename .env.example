# Copy to .env and fill in real values. Never commit .env.

# DockerHub image
DOCKERHUB_NAMESPACE=
DOCKERHUB_REPOSITORY=
IMAGE_TAG=

# Postgres connection
POSTGRES_CONN_USERNAME=
POSTGRES_CONN_PASSWORD=
POSTGRES_CONN_HOST=
POSTGRES_CONN_PORT=

# Metadata database credentials
METADATA_DATABASE_NAME=
METADATA_DATABASE_USERNAME=
METADATA_DATABASE_PASSWORD=

# Celery database credentials
CELERY_BACKEND_NAME=
CELERY_BACKEND_USERNAME=
CELERY_BACKEND_PASSWORD=

# ELT database credentials
ELT_DATABASE_NAME=
ELT_DATABASE_USERNAME=
ELT_DATABASE_PASSWORD=

# Airflow params
AIRFLOW_UID=50000
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
API_KEY=
AIRFLOW_WWW_USER_USERNAME=
AIRFLOW_WWW_USER_PASSWORD=

# Postgres connection for daily use (API)
POSTGRES_CONN_DAILY_USERNAME=
POSTGRES_CONN_DAILY_PASSWORD=
POSTGRES_CONN_DAILY_HOST=localhost
POSTGRES_CONN_DAILY_PORT=5435
POSTGRES_CONN_DAILY_DB=

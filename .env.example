# Copy to .env and fill the real values. NEVER commit .env
# DockerHub image
DOCKERHUB_NAMESPACE=restaurantssiasun
DOCKERHUB_REPOSITORY=rt_api_elt
IMAGE_TAG=1.0.0

# Postgres connection - POSTGRES_CONN_USERNAME set to the default postgres user to not create another db
POSTGRES_CONN_USERNAME=postgres
POSTGRES_CONN_HOST=postgres
POSTGRES_CONN_PORT=5432

# Metadata database credentials
METADATA_DATABASE_NAME=airflow_metadata_db
METADATA_DATABASE_USERNAME=airflow_meta_user

# Celery database credentials
CELERY_BACKEND_NAME=celery_results_db
CELERY_BACKEND_USERNAME=celery_user

# ELT database credentials
ELT_DATABASE_NAME=elt_db
ELT_DATABASE_USERNAME=yt_api_user

# Airflow params 
AIRFLOW_UID="50000"
FERNET_KEY="CHANGE_ME_generate_with_cryptography_Fernet"

# Postgres connection for daily use
POSTGRES_CONN_DAILY_USERNAME=dailyuser
POSTGRES_CONN_DAILY_PASSWORD=CHANGE_ME_strong_password
POSTGRES_CONN_DAILY_PORT=5435
POSTGRES_CONN_DAILY_DB=dailydatabase

# API (customer-facing): every request must send the header  X-API-Key: <API_KEY>
# REQUIRED: generate with  python -c "import secrets;print(secrets.token_urlsafe(32))"  (empty = API rejects everything)
API_KEY=
# Swagger /docs : keep false in production
ENABLE_DOCS=false
# Origins allowed to call the API from a browser (comma separated), empty = none
CORS_ALLOW_ORIGINS=
LOG_LEVEL=INFO
# Number of tables (must match the dropdown in web/index.html)
TABLE_COUNT=5
# Rate limit per IP per minute for the public web endpoints
RATE_LIMIT_READ=120
RATE_LIMIT_WRITE=30
# PromptPay receiver for the payment QR( 10 digits phone or 13 digits id ). Default below is a FAKE test account - never transfer real money to it.
PROMPTPAY_ID=0800000000
